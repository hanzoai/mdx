{
  "name": "@hanzo/mdx",
  "version": "14.2.6",
  "description": "MDX processing library for Hanzo",
  "keywords": [
    "Hanzo",
    "MDX",
    "Documentation"
  ],
  "homepage": "https://hanzo.ai",
  "repository": "github:hanzoai/mdx",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./loader-mdx": "./loader-mdx.cjs",
    "./loader-meta": "./loader-meta.cjs",
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./next": {
      "import": "./dist/next/index.js",
      "types": "./dist/next/index.d.ts",
      "require": "./dist/next/index.cjs"
    },
    "./vite": {
      "import": "./dist/vite/index.js",
      "types": "./dist/vite/index.d.ts"
    },
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime/*": {
      "import": "./dist/runtime/*.js",
      "types": "./dist/runtime/*.d.ts"
    },
    "./node/loader": {
      "import": "./dist/node/loader.js",
      "types": "./dist/node/loader.d.ts"
    },
    "./bun": {
      "import": "./dist/bun/index.js",
      "types": "./dist/bun/index.d.ts"
    },
    "./plugins/*": {
      "import": "./dist/plugins/*.js",
      "types": "./dist/plugins/*.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hanzo-mdx": "./dist/bin.js"
  },
  "files": [
    "dist/*",
    "loader-mdx.cjs",
    "loader-meta.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "types:check": "tsc --noEmit",
    "release": "pnpm run build && changeset publish",
    "version": "changeset version && pnpm install --lockfile-only"
  },
  "dependencies": {
    "@hanzo/mdx-runtime": "1.6.1",
    "@mdx-js/mdx": "^3.1.1",
    "@standard-schema/spec": "^1.1.0",
    "chokidar": "^5.0.0",
    "esbuild": "^0.28.2",
    "estree-util-value-to-estree": "^3.5.0",
    "js-yaml": "^5.4.1",
    "mdast-util-to-markdown": "^2.1.2",
    "picocolors": "^1.1.1",
    "picomatch": "^4.0.7",
    "remark-mdx": "^3.1.1",
    "tinyexec": "^1.3.0",
    "tinyglobby": "^0.2.17",
    "unified": "^11.0.5",
    "unist-util-remove-position": "^5.0.0",
    "unist-util-visit": "^5.1.0",
    "vfile": "^6.0.3",
    "zod": "^4.5.2"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.1",
    "@hanzo/docs-core": "17.0.1",
    "@types/bun": "^1.4.0",
    "@types/js-yaml": "^4.0.9",
    "@types/mdast": "^4.0.4",
    "@types/mdx": "^2.0.14",
    "@types/node": "26.4.0",
    "@types/picomatch": "^4.0.3",
    "@types/react": "19.2.18",
    "mdast-util-directive": "^3.1.0",
    "mdast-util-mdx-jsx": "^3.2.0",
    "next": "16.3.3",
    "react": "19.2.8",
    "remark": "^15.0.1",
    "remark-directive": "^4.0.0",
    "remark-stringify": "^11.0.0",
    "rimraf": "^6.1.3",
    "rollup": "^4.63.1",
    "tsup": "^8.5.1",
    "typescript": "7.0.2",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "webpack": "^5.110.1"
  },
  "peerDependencies": {
    "@hanzo/docs-core": ">=17.0.1",
    "next": ">=16.3.3",
    "react": ">=19.2.8",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.24.0"
}
