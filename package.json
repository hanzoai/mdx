{
  "name": "@hanzo/mdx",
  "version": "14.2.6",
  "description": "MDX processing library for Hanzo",
  "keywords": [
    "Hanzo",
    "MDX",
    "Documentation"
  ],
  "homepage": "https://hanzo.ai",
  "repository": "github:hanzoai/mdx",
  "license": "MIT",
  "type": "module",
  "exports": {
    "./loader-mdx": "./loader-mdx.cjs",
    "./loader-meta": "./loader-meta.cjs",
    "./config": {
      "import": "./dist/config/index.js",
      "types": "./dist/config/index.d.ts"
    },
    "./next": {
      "import": "./dist/next/index.js",
      "types": "./dist/next/index.d.ts",
      "require": "./dist/next/index.cjs"
    },
    "./vite": {
      "import": "./dist/vite/index.js",
      "types": "./dist/vite/index.d.ts"
    },
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./runtime/*": {
      "import": "./dist/runtime/*.js",
      "types": "./dist/runtime/*.d.ts"
    },
    "./node/loader": {
      "import": "./dist/node/loader.js",
      "types": "./dist/node/loader.d.ts"
    },
    "./bun": {
      "import": "./dist/bun/index.js",
      "types": "./dist/bun/index.d.ts"
    },
    "./plugins/*": {
      "import": "./dist/plugins/*.js",
      "types": "./dist/plugins/*.d.ts"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "hanzo-mdx": "./dist/bin.js"
  },
  "files": [
    "dist/*",
    "loader-mdx.cjs",
    "loader-meta.cjs"
  ],
  "scripts": {
    "build": "tsup",
    "clean": "rimraf dist",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "test": "vitest run",
    "types:check": "tsc --noEmit",
    "release": "pnpm run build && changeset publish",
    "version": "changeset version && pnpm install --lockfile-only"
  },
  "dependencies": {
    "@hanzo/mdx-runtime": "catalog:",
    "@mdx-js/mdx": "catalog:",
    "@standard-schema/spec": "catalog:",
    "chokidar": "catalog:",
    "esbuild": "catalog:",
    "estree-util-value-to-estree": "catalog:",
    "js-yaml": "catalog:",
    "mdast-util-to-markdown": "catalog:",
    "picocolors": "catalog:",
    "picomatch": "catalog:",
    "remark-mdx": "catalog:",
    "tinyexec": "catalog:",
    "tinyglobby": "catalog:",
    "unified": "catalog:",
    "unist-util-remove-position": "catalog:",
    "unist-util-visit": "catalog:",
    "vfile": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:",
    "@hanzo/docs-core": "catalog:",
    "@types/bun": "catalog:",
    "@types/js-yaml": "catalog:",
    "@types/mdast": "catalog:",
    "@types/mdx": "catalog:",
    "@types/node": "catalog:",
    "@types/picomatch": "catalog:",
    "@types/react": "catalog:",
    "mdast-util-directive": "catalog:",
    "mdast-util-mdx-jsx": "catalog:",
    "next": "catalog:",
    "react": "catalog:",
    "remark": "catalog:",
    "remark-directive": "catalog:",
    "remark-stringify": "catalog:",
    "rimraf": "catalog:",
    "rollup": "catalog:",
    "tsup": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:",
    "webpack": "catalog:"
  },
  "peerDependencies": {
    "@hanzo/docs-core": ">=17.0.1",
    "next": ">=16.3.3",
    "react": ">=19.2.8",
    "vite": ">=8"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    },
    "next": {
      "optional": true
    },
    "vite": {
      "optional": true
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.24.0"
}
